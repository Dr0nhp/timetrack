{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeTrack",
  "version": "0.5.0",
  "identifier": "com.timetrack.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TimeTrack",
        "width": 920,
        "height": 720,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwNzhDREREODU3REEwNzIKUldSeW9IMkYzYzE0TUgrR0pPbWl2VzJjcGNET1ZDOC9pSHp3U2dNb0h5dW43QW9sYjRrMmR3VDYK",
      "endpoints": [
        "https://github.com/Dr0nhp/timetrack/releases/latest/download/latest.json"
      ]
    }
  }
}
