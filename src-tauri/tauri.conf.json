{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeTrack",
  "version": "0.1.0",
  "identifier": "com.timetrack.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TimeTrack",
        "width": 920,
        "height": 720,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": {
        "NSAppleEventsUsageDescription": "TimeTrack needs accessibility access to record which apps and browser tabs you use."
      }
    }
  }
}
